# Use after sdkconfig.defaults with a separate sdkconfig.i2s-diag/build-i2s-diag.
# Comparison 1: persistent I2S + CLK1/QSD, with BS170s absent and CLK0 off.
CONFIG_DXFT8_REAL_RF_BOARD=y
CONFIG_DXFT8_SCOPE_CLK0_CARRIER=n
CONFIG_DXFT8_RUN_TX_PATH_SELF_TEST=n
CONFIG_DXFT8_RUN_I2S_SELF_TEST=y
CONFIG_DXFT8_I2S_MOCK_PATTERN_TEST=n
CONFIG_DXFT8_I2S_CAPTURE_STATS=n
CONFIG_DXFT8_I2S_CONTINUOUS_DIAGNOSTIC=y
CONFIG_DXFT8_I2S_DIAGNOSTIC_RX_CLOCK=y
CONFIG_DXFT8_TAB5_I2S_SAMPLE_RATE_HZ=48000
