# Add after sdkconfig.defaults using a SEPARATE sdkconfig and build directory.
# Scope-only real-board bring-up. BS170s MUST remain uninstalled.
CONFIG_DXFT8_REAL_RF_BOARD=y
CONFIG_DXFT8_SCOPE_CLK0_CARRIER=y
CONFIG_DXFT8_RUN_TX_PATH_SELF_TEST=n
# CLK0 can be scoped independently of the ADC. The first powered real-board
# ADC test returned constant -1 samples; do not mistake this for an I2S pass.
# Enable RUN_I2S_SELF_TEST + CAPTURE_STATS explicitly when investigating it.
CONFIG_DXFT8_RUN_I2S_SELF_TEST=n
